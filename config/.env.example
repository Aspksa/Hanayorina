# Copy this file to .env and set the PostgreSQL account you created locally.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=hanayorina
PGUSER=hanayorina
PGPASSWORD=replace_with_your_password

# Необязательно: модель эмбеддингов OpenAI-совместимого основного API.
# Запросы эмбеддингов могут оплачиваться. Требуется установленное расширение pgvector.
# MEMORY_EMBEDDING_MODEL=название-модели-эмбеддингов

# Рабочая папка для команд чата, только абсолютный путь (Windows):
# HANAYORINA_WORKSPACE_ROOT='D:\Hanayorina\work'

# 1 включает локальную фоновую индексацию выбранной рабочей папки; по умолчанию выключено.
# HANAYORINA_LIBRARY_INDEX=1
